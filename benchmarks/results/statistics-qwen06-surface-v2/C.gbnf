root ::= failure | a-root
answer ::= "{" ws "\"v\"" ws ":" ws decimal ws "}" ws
failure ::= "{" ws "\"e\"" ws ":" ws error ws "}" ws
error ::= "\"AMBIGUOUS_METHOD\"" | "\"MISSING_INFORMATION\"" | "\"UNSUPPORTED_OPERATION\"" | "\"INSUFFICIENT_DATA\"" | "\"ARGUMENT_TYPE\"" | "\"DOMAIN_ERROR\"" | "\"DIVIDE_BY_ZERO\"" | "\"RESOURCE_LIMIT\"" | "\"OVERFLOW\"" | "\"INVALID_REQUEST\"" | "\"INVALID_DECIMAL\"" | "\"ARGUMENT_COUNT\"" | "\"PRECISION_UNRESOLVED\""
decimal ::= "\"" "-"? ("0" | [1-9] [0-9]{0,95}) ("." [0-9]{1,95})? "\""
ws ::= [ \t\n\r]*
a-root ::= a-ws (a-op-0 | a-op-1 | a-op-2 | a-op-3 | a-op-4 | a-op-5 | a-op-6 | a-op-7) a-ws
a-op-0 ::= "{" a-ws "\"op\"" a-ws ":" a-ws "\"stats.corr.pearson\"" a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-decimal-vector a-ws "," a-ws a-decimal-vector a-ws "]" a-ws "}"
a-op-1 ::= "{" a-ws "\"op\"" a-ws ":" a-ws "\"stats.mean\"" a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-decimal-vector a-ws "]" a-ws "}"
a-op-2 ::= "{" a-ws "\"op\"" a-ws ":" a-ws "\"stats.mean.weighted\"" a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-decimal-vector a-ws "," a-ws a-decimal-vector a-ws "]" a-ws "}"
a-op-3 ::= "{" a-ws "\"op\"" a-ws ":" a-ws "\"stats.sd.pop\"" a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-decimal-vector a-ws "]" a-ws "}"
a-op-4 ::= "{" a-ws "\"op\"" a-ws ":" a-ws "\"stats.sd.sample\"" a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-decimal-vector a-ws "]" a-ws "}"
a-op-5 ::= "{" a-ws "\"op\"" a-ws ":" a-ws "\"stats.sum\"" a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-decimal-vector a-ws "]" a-ws "}"
a-op-6 ::= "{" a-ws "\"op\"" a-ws ":" a-ws "\"stats.var.pop\"" a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-decimal-vector a-ws "]" a-ws "}"
a-op-7 ::= "{" a-ws "\"op\"" a-ws ":" a-ws "\"stats.var.sample\"" a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-decimal-vector a-ws "]" a-ws "}"
a-decimal-vector ::= "[" a-ws (a-decimal-string (a-ws "," a-ws a-decimal-string){0,63})? a-ws "]"
a-decimal-string ::= "\"" "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)? "\""
a-ws ::= [ \t\n\r]*
