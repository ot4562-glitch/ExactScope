root ::= failure | a-root | b-root
answer ::= "{" ws "\"v\"" ws ":" ws decimal ws "}" ws
failure ::= "{" ws "\"e\"" ws ":" ws error ws "}" ws
error ::= "\"AMBIGUOUS_METHOD\"" | "\"MISSING_INFORMATION\"" | "\"UNSUPPORTED_OPERATION\"" | "\"INSUFFICIENT_DATA\"" | "\"ARGUMENT_TYPE\"" | "\"DOMAIN_ERROR\"" | "\"DIVIDE_BY_ZERO\"" | "\"RESOURCE_LIMIT\"" | "\"OVERFLOW\"" | "\"INVALID_REQUEST\"" | "\"INVALID_DECIMAL\"" | "\"ARGUMENT_COUNT\"" | "\"PRECISION_UNRESOLVED\""
decimal ::= "\"" "-"? ("0" | [1-9] [0-9]{0,95}) ("." [0-9]{1,95})? "\""
ws ::= [ \t\n\r]*
a-root ::= a-ws "{" a-ws "\"p\"" a-ws ":" a-ws "[" a-ws a-steps a-ws "]" a-ws "}" a-ws
a-steps ::= a-step | a-step a-comma a-step | a-step a-comma a-step a-comma a-step | a-step a-comma a-step a-comma a-step a-comma a-step | a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step | a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step | a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step | a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step a-comma a-step
a-step ::= a-binary-step | a-sqrt-step
a-binary-step ::= "{" a-ws "\"o\"" a-ws ":" a-ws a-binary-op a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-value a-ws "," a-ws a-value a-ws "]" a-ws "}"
a-sqrt-step ::= "{" a-ws "\"o\"" a-ws ":" a-ws "\"sqrt\"" a-ws "," a-ws "\"a\"" a-ws ":" a-ws "[" a-ws a-value a-ws "]" a-ws "}"
a-binary-op ::= "\"add\"" | "\"sub\"" | "\"mul\"" | "\"div\"" | "\"powi\""
a-value ::= a-decimal-string | a-result-ref
a-result-ref ::= "\"#0\"" | "\"#1\"" | "\"#2\"" | "\"#3\"" | "\"#4\"" | "\"#5\"" | "\"#6\"" | "\"#7\""
a-decimal-string ::= "\"" "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)? "\""
a-comma ::= a-ws "," a-ws
a-ws ::= "" | [ \t\n\r] | [ \t\n\r] [ \t\n\r] | [ \t\n\r] [ \t\n\r] [ \t\n\r] | [ \t\n\r] [ \t\n\r] [ \t\n\r] [ \t\n\r]

b-root ::= b-ws (b-op-0 | b-op-1 | b-op-2 | b-op-3 | b-op-4 | b-op-5 | b-op-6 | b-op-7) b-ws
b-op-0 ::= "{" b-ws "\"op\"" b-ws ":" b-ws "\"stats.corr.pearson\"" b-ws "," b-ws "\"a\"" b-ws ":" b-ws "[" b-ws b-decimal-vector b-ws "," b-ws b-decimal-vector b-ws "]" b-ws "}"
b-op-1 ::= "{" b-ws "\"op\"" b-ws ":" b-ws "\"stats.mean\"" b-ws "," b-ws "\"a\"" b-ws ":" b-ws "[" b-ws b-decimal-vector b-ws "]" b-ws "}"
b-op-2 ::= "{" b-ws "\"op\"" b-ws ":" b-ws "\"stats.mean.weighted\"" b-ws "," b-ws "\"a\"" b-ws ":" b-ws "[" b-ws b-decimal-vector b-ws "," b-ws b-decimal-vector b-ws "]" b-ws "}"
b-op-3 ::= "{" b-ws "\"op\"" b-ws ":" b-ws "\"stats.sd.pop\"" b-ws "," b-ws "\"a\"" b-ws ":" b-ws "[" b-ws b-decimal-vector b-ws "]" b-ws "}"
b-op-4 ::= "{" b-ws "\"op\"" b-ws ":" b-ws "\"stats.sd.sample\"" b-ws "," b-ws "\"a\"" b-ws ":" b-ws "[" b-ws b-decimal-vector b-ws "]" b-ws "}"
b-op-5 ::= "{" b-ws "\"op\"" b-ws ":" b-ws "\"stats.sum\"" b-ws "," b-ws "\"a\"" b-ws ":" b-ws "[" b-ws b-decimal-vector b-ws "]" b-ws "}"
b-op-6 ::= "{" b-ws "\"op\"" b-ws ":" b-ws "\"stats.var.pop\"" b-ws "," b-ws "\"a\"" b-ws ":" b-ws "[" b-ws b-decimal-vector b-ws "]" b-ws "}"
b-op-7 ::= "{" b-ws "\"op\"" b-ws ":" b-ws "\"stats.var.sample\"" b-ws "," b-ws "\"a\"" b-ws ":" b-ws "[" b-ws b-decimal-vector b-ws "]" b-ws "}"
b-decimal-vector ::= "[" b-ws (b-decimal-string (b-ws "," b-ws b-decimal-string){0,63})? b-ws "]"
b-decimal-string ::= "\"" "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)? "\""
b-ws ::= [ \t\n\r]*
