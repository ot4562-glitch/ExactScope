root ::= failure | lane0-root
answer ::= "{" ws "\"v\"" ws ":" ws decimal ws "}" ws
failure ::= "{" ws "\"e\"" ws ":" ws error ws "}" ws
error ::= "\"AMBIGUOUS_METHOD\"" | "\"MISSING_INFORMATION\"" | "\"UNSUPPORTED_OPERATION\"" | "\"INSUFFICIENT_DATA\"" | "\"ARGUMENT_TYPE\"" | "\"DOMAIN_ERROR\"" | "\"DIVIDE_BY_ZERO\"" | "\"RESOURCE_LIMIT\"" | "\"OVERFLOW\"" | "\"INVALID_REQUEST\"" | "\"INVALID_DECIMAL\"" | "\"ARGUMENT_COUNT\"" | "\"PRECISION_UNRESOLVED\""
decimal ::= "\"" "-"? ("0" | [1-9] [0-9]{0,95}) ("." [0-9]{1,95})? "\""
ws ::= [ \t\n\r]*
lane0-root ::= lane0-ws (lane0-op-0 | lane0-op-1 | lane0-op-2 | lane0-op-3 | lane0-op-4 | lane0-op-5 | lane0-op-6 | lane0-op-7) lane0-ws
lane0-op-0 ::= "{" lane0-ws "\"op\"" lane0-ws ":" lane0-ws "\"stats.corr.pearson\"" lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-decimal-vector lane0-ws "," lane0-ws lane0-decimal-vector lane0-ws "]" lane0-ws "}"
lane0-op-1 ::= "{" lane0-ws "\"op\"" lane0-ws ":" lane0-ws "\"stats.mean\"" lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-decimal-vector lane0-ws "]" lane0-ws "}"
lane0-op-2 ::= "{" lane0-ws "\"op\"" lane0-ws ":" lane0-ws "\"stats.mean.weighted\"" lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-decimal-vector lane0-ws "," lane0-ws lane0-decimal-vector lane0-ws "]" lane0-ws "}"
lane0-op-3 ::= "{" lane0-ws "\"op\"" lane0-ws ":" lane0-ws "\"stats.sd.pop\"" lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-decimal-vector lane0-ws "]" lane0-ws "}"
lane0-op-4 ::= "{" lane0-ws "\"op\"" lane0-ws ":" lane0-ws "\"stats.sd.sample\"" lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-decimal-vector lane0-ws "]" lane0-ws "}"
lane0-op-5 ::= "{" lane0-ws "\"op\"" lane0-ws ":" lane0-ws "\"stats.sum\"" lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-decimal-vector lane0-ws "]" lane0-ws "}"
lane0-op-6 ::= "{" lane0-ws "\"op\"" lane0-ws ":" lane0-ws "\"stats.var.pop\"" lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-decimal-vector lane0-ws "]" lane0-ws "}"
lane0-op-7 ::= "{" lane0-ws "\"op\"" lane0-ws ":" lane0-ws "\"stats.var.sample\"" lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-decimal-vector lane0-ws "]" lane0-ws "}"
lane0-decimal-vector ::= "[" lane0-ws (lane0-decimal-string (lane0-ws "," lane0-ws lane0-decimal-string){0,63})? lane0-ws "]"
lane0-decimal-string ::= "\"" "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)? "\""
lane0-ws ::= [ \t\n\r]*
