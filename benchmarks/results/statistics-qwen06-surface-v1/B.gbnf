root ::= failure | lane0-root
answer ::= "{" ws "\"v\"" ws ":" ws decimal ws "}" ws
failure ::= "{" ws "\"e\"" ws ":" ws error ws "}" ws
error ::= "\"AMBIGUOUS_METHOD\"" | "\"MISSING_INFORMATION\"" | "\"UNSUPPORTED_OPERATION\"" | "\"INSUFFICIENT_DATA\"" | "\"ARGUMENT_TYPE\"" | "\"DOMAIN_ERROR\"" | "\"DIVIDE_BY_ZERO\"" | "\"RESOURCE_LIMIT\"" | "\"OVERFLOW\"" | "\"INVALID_REQUEST\"" | "\"INVALID_DECIMAL\"" | "\"ARGUMENT_COUNT\"" | "\"PRECISION_UNRESOLVED\""
decimal ::= "\"" "-"? ("0" | [1-9] [0-9]{0,95}) ("." [0-9]{1,95})? "\""
ws ::= [ \t\n\r]*
lane0-root ::= lane0-ws "{" lane0-ws "\"p\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-steps lane0-ws "]" lane0-ws "}" lane0-ws
lane0-steps ::= lane0-step | lane0-step lane0-comma lane0-step | lane0-step lane0-comma lane0-step lane0-comma lane0-step | lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step | lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step | lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step | lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step | lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step lane0-comma lane0-step
lane0-step ::= lane0-binary-step | lane0-sqrt-step
lane0-binary-step ::= "{" lane0-ws "\"o\"" lane0-ws ":" lane0-ws lane0-binary-op lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-value lane0-ws "," lane0-ws lane0-value lane0-ws "]" lane0-ws "}"
lane0-sqrt-step ::= "{" lane0-ws "\"o\"" lane0-ws ":" lane0-ws "\"sqrt\"" lane0-ws "," lane0-ws "\"a\"" lane0-ws ":" lane0-ws "[" lane0-ws lane0-value lane0-ws "]" lane0-ws "}"
lane0-binary-op ::= "\"add\"" | "\"sub\"" | "\"mul\"" | "\"div\"" | "\"powi\""
lane0-value ::= lane0-decimal-string | lane0-result-ref
lane0-result-ref ::= "\"#0\"" | "\"#1\"" | "\"#2\"" | "\"#3\"" | "\"#4\"" | "\"#5\"" | "\"#6\"" | "\"#7\""
lane0-decimal-string ::= "\"" "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)? "\""
lane0-comma ::= lane0-ws "," lane0-ws
lane0-ws ::= "" | [ \t\n\r] | [ \t\n\r] [ \t\n\r] | [ \t\n\r] [ \t\n\r] [ \t\n\r] | [ \t\n\r] [ \t\n\r] [ \t\n\r] [ \t\n\r]
