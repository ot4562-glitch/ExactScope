root ::= ws (op-0) ws
op-0 ::= "{" ws "\"op\"" ws ":" ws "\"econ.ped.mid\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-string ws "," ws decimal-string ws "," ws decimal-string ws "," ws decimal-string ws "]" ws "}"
decimal-vector ::= "[" ws (decimal-string (ws "," ws decimal-string)*)? ws "]"
decimal-string ::= "\"" "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)? "\""
ws ::= [ \t\n\r]*
