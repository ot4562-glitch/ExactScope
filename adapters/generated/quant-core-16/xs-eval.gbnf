root ::= ws (op-0 | op-1 | op-2 | op-3 | op-4 | op-5 | op-6 | op-7 | op-8 | op-9 | op-10 | op-11 | op-12 | op-13 | op-14 | op-15) ws
op-0 ::= "{" ws "\"op\"" ws ":" ws "\"econ.ped.mid\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-string ws "," ws decimal-string ws "," ws decimal-string ws "," ws decimal-string ws "]" ws "}"
op-1 ::= "{" ws "\"op\"" ws ":" ws "\"econ.gdp.deflator100\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-string ws "," ws decimal-string ws "]" ws "}"
op-2 ::= "{" ws "\"op\"" ws ":" ws "\"econ.inflation.cpi_pct\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-string ws "," ws decimal-string ws "]" ws "}"
op-3 ::= "{" ws "\"op\"" ws ":" ws "\"econ.money.velocity\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-string ws "," ws decimal-string ws "]" ws "}"
op-4 ::= "{" ws "\"op\"" ws ":" ws "\"econ.rate.real.exact_pct\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-string ws "," ws decimal-string ws "]" ws "}"
op-5 ::= "{" ws "\"op\"" ws ":" ws "\"econ.rate.real.approx_pct\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-string ws "," ws decimal-string ws "]" ws "}"
op-6 ::= "{" ws "\"op\"" ws ":" ws "\"econ.output_gap_pct\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-string ws "," ws decimal-string ws "]" ws "}"
op-7 ::= "{" ws "\"op\"" ws ":" ws "\"econ.growth.rate_pct\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-string ws "," ws decimal-string ws "]" ws "}"
op-8 ::= "{" ws "\"op\"" ws ":" ws "\"stats.sum\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-vector ws "]" ws "}"
op-9 ::= "{" ws "\"op\"" ws ":" ws "\"stats.mean\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-vector ws "]" ws "}"
op-10 ::= "{" ws "\"op\"" ws ":" ws "\"stats.mean.weighted\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-vector ws "," ws decimal-vector ws "]" ws "}"
op-11 ::= "{" ws "\"op\"" ws ":" ws "\"stats.var.pop\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-vector ws "]" ws "}"
op-12 ::= "{" ws "\"op\"" ws ":" ws "\"stats.var.sample\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-vector ws "]" ws "}"
op-13 ::= "{" ws "\"op\"" ws ":" ws "\"stats.sd.pop\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-vector ws "]" ws "}"
op-14 ::= "{" ws "\"op\"" ws ":" ws "\"stats.sd.sample\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-vector ws "]" ws "}"
op-15 ::= "{" ws "\"op\"" ws ":" ws "\"stats.corr.pearson\"" ws "," ws "\"a\"" ws ":" ws "[" ws decimal-vector ws "," ws decimal-vector ws "]" ws "}"
decimal-vector ::= "[" ws (decimal-string (ws "," ws decimal-string)*)? ws "]"
decimal-string ::= "\"" "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)? "\""
ws ::= [ \t\n\r]*
