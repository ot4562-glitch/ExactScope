{
  "type": "function",
  "function": {
    "name": "xs_calc",
    "description": "Execute one bounded deterministic arithmetic plan in ExactScope. Use 1-8 steps. Allowed operations: add, sub, mul, div, powi, sqrt. Pass exact decimal strings and only backward result references #0 through #7. Do not invent missing values or semantic assumptions.",
    "parameters": {
      "type": "object",
      "properties": {
        "p": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "o": {
                    "type": "string",
                    "enum": ["add", "sub", "mul", "div", "powi"]
                  },
                  "a": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 96,
                      "pattern": "^(?:#[0-7]|-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)$"
                    }
                  }
                },
                "required": ["o", "a"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "o": {
                    "const": "sqrt"
                  },
                  "a": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 96,
                      "pattern": "^(?:#[0-7]|-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)$"
                    }
                  }
                },
                "required": ["o", "a"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["p"],
      "additionalProperties": false
    }
  }
}
