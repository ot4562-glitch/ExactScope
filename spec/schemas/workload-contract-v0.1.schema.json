{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/workload-contract-v0.1.schema.json",
  "title": "ExactScope Workload Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1},
    "format": {"const": "exactscope.workload-contract"},
    "format_version": {"const": "0.1"},
    "workload_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "workload_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "population_identity": {"type": "string", "minLength": 1, "maxLength": 512},
    "runtime_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "obligation_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {
            "enum": [
              "allowed-source-set",
              "source-revision",
              "citation-membership",
              "output-schema",
              "exact-extraction",
              "context-admission",
              "required-capability",
              "profile-identity",
              "custom-registered"
            ]
          },
          "rule_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "failure_reason": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "required": ["obligation_id", "kind", "rule_id", "failure_reason"]
      },
      "minItems": 1
    },
    "empirical_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "metric_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "direction": {"enum": ["min", "max", "zero"]},
          "threshold": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "unit": {"type": "string", "minLength": 1, "maxLength": 128},
          "mandatory": {"const": true}
        },
        "required": ["requirement_id", "metric_id", "direction", "threshold", "unit", "mandatory"]
      },
      "minItems": 1
    },
    "answer_contract_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "evidence_policy_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "evidence_composition": {
      "enum": ["unspecified", "single-source-precision", "multi-source-coverage"]
    },
    "evidence_budget_bytes": {
      "oneOf": [
        {"type": "null"},
        {"type": "integer", "minimum": 256, "maximum": 1048576}
      ]
    },
    "economic_model_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "invalidation_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unknown_change": {"const": "full-requalification"},
        "targeted_requalification_allowed": {"type": "boolean"},
        "dependency_rule_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "nonbehavioral_dependency_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256},
          "uniqueItems": true
        },
        "targeted_dependency_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256},
          "uniqueItems": true
        }
      },
      "required": [
        "unknown_change",
        "targeted_requalification_allowed",
        "dependency_rule_id",
        "nonbehavioral_dependency_ids",
        "targeted_dependency_ids"
      ]
    }
  },
  "required": [
    "v",
    "format",
    "format_version",
    "workload_id",
    "workload_revision",
    "population_identity",
    "runtime_obligations",
    "empirical_requirements",
    "answer_contract_id",
    "evidence_policy_id",
    "economic_model_id",
    "invalidation_policy"
  ]
}
