{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/model-surface-acceptance.schema.json",
  "title": "ExactScope model-surface host acceptance v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "accepted_abi_revisions", "accepted_hotset_format_versions", "accepted_asset_contracts", "require_exact_asset_digests"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 256},
    "format": {"const": "exactscope.model-surface.acceptance"},
    "format_version": {"const": "0.1"},
    "accepted_abi_revisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 32}
    },
    "accepted_hotset_format_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 32}
    },
    "accepted_asset_contracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1, "maxLength": 32}
      },
      "propertyNames": {"pattern": "^exactscope\\.[A-Za-z0-9._-]+$"}
    },
    "require_exact_asset_digests": {"const": true}
  }
}
