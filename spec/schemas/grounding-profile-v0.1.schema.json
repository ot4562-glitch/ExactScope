{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/grounding-profile-v0.1.schema.json",
  "title": "ExactScope grounding-profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "format_version": {
      "const": "0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "canonical_encoding": {
      "const": "grounding-cjson-v0.1"
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "enum": [
            "raw",
            "grounding-cjson-v0.1"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "encoding"
      ]
    },
    "allowed_namespaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "grounding-target-plan-v0.1.schema.json"
      },
      "minItems": 1
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "encoding": {
                "enum": [
                  "raw",
                  "grounding-cjson-v0.1"
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "encoding"
            ]
          }
        },
        "required": [
          "provider_id",
          "identity"
        ]
      },
      "minItems": 1
    },
    "source_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "encoding": {
            "enum": [
              "raw",
              "grounding-cjson-v0.1"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "encoding"
        ]
      },
      "minItems": 1
    },
    "merge_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "enum": [
            "raw",
            "grounding-cjson-v0.1"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "encoding"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "encoding": {
              "enum": [
                "raw",
                "grounding-cjson-v0.1"
              ]
            }
          },
          "required": [
            "path",
            "sha256",
            "encoding"
          ]
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "encoding": {
              "enum": [
                "raw",
                "grounding-cjson-v0.1"
              ]
            }
          },
          "required": [
            "path",
            "sha256",
            "encoding"
          ]
        },
        "renderer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "encoding": {
              "enum": [
                "raw",
                "grounding-cjson-v0.1"
              ]
            }
          },
          "required": [
            "path",
            "sha256",
            "encoding"
          ]
        }
      },
      "required": [
        "id",
        "template",
        "policy",
        "renderer"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "target_groups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "providers_per_target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sources_per_binding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidates_per_invocation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "items_per_target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "content_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "content_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "frame_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_evidence_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "model_context_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "answer_calls": {
          "const": 1
        },
        "rewrite_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokenizer_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_claims": {
          "type": "null"
        }
      },
      "required": [
        "query_bytes",
        "target_groups",
        "providers_per_target",
        "sources_per_binding",
        "provider_attempts",
        "candidates_per_invocation",
        "items_per_target",
        "content_bytes",
        "content_depth",
        "frame_bytes",
        "model_items",
        "model_evidence_bytes",
        "model_context_bytes",
        "answer_calls",
        "rewrite_calls",
        "evidence_tokens",
        "tokenizer_sha256",
        "resource_claims"
      ]
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measurement_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "start_point": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retrieval_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "provider_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "retryable_statuses": {
          "type": "array",
          "items": {
            "enum": [
              "timeout",
              "error",
              "denied",
              "budget_exceeded"
            ]
          },
          "minItems": 0
        },
        "backoff_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cancellation_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "late_result_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "partial_result_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "measurement_domain",
        "start_point",
        "retrieval_ms",
        "provider_ms",
        "maximum_attempts",
        "retryable_statuses",
        "backoff_ms",
        "cancellation_rule",
        "late_result_rule",
        "partial_result_rule"
      ]
    },
    "rewrite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "encoding": {
              "enum": [
                "raw",
                "grounding-cjson-v0.1"
              ]
            }
          },
          "required": [
            "path",
            "sha256",
            "encoding"
          ]
        }
      },
      "required": [
        "enabled"
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "enum": [
            "denied",
            "host-authorized"
          ]
        },
        "authorized_providers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0
        },
        "scope_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cache_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "audit_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "network",
        "authorized_providers",
        "data_classes",
        "scope_rule",
        "cache_rule",
        "audit_rule"
      ]
    }
  },
  "required": [
    "v",
    "format_version",
    "profile_id",
    "canonical_encoding",
    "router",
    "allowed_namespaces",
    "targets",
    "providers",
    "source_snapshots",
    "merge_policy",
    "projection",
    "limits",
    "timeouts",
    "rewrite",
    "privacy"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "rewrite": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "rewrite": {
            "required": [
              "identity"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rewrite": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "limits": {
            "properties": {
              "rewrite_calls": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
