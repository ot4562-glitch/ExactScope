{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/build-input-identity.schema.json",
  "title": "ExactScope build-input identity v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "project_version", "release_profile", "target", "capability", "rust", "source_identity_sha256", "input_files", "claim"],
  "properties": {
    "format": {"const": "exactscope.build-input-identity"},
    "format_version": {"const": "0.1"},
    "project_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "release_profile": {"type": "string", "enum": ["native-static", "no-import-wasm"]},
    "target": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s]+$"},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_sha256", "profile_id", "profile_revision", "domain", "core_revision", "surface_contract_sha256"],
      "properties": {
        "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "profile_revision": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "domain": {"type": "string", "minLength": 1, "maxLength": 64},
        "core_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "surface_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "rust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "features", "locked", "release_profile"],
      "properties": {
        "channel": {"type": "string", "minLength": 1, "maxLength": 64},
        "features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
        "locked": {"const": true},
        "release_profile": {"const": "release"}
      }
    },
    "source_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9._/-]+$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "claim": {"const": "Build inputs pinned; independent byte-for-byte rebuild comparison not yet performed."}
  }
}
