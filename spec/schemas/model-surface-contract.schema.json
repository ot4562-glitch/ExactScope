{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/model-surface-contract.schema.json",
  "title": "ExactScope model-surface contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "negotiation", "profile", "abi_revision", "hotset", "assets"],
  "properties": {
    "format": {"const": "exactscope.model-surface.contract"},
    "format_version": {"const": "0.1"},
    "negotiation": {"const": "exact-version-and-digest"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "domain"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "domain": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
      }
    },
    "abi_revision": {"type": "string", "minLength": 1, "maxLength": 32},
    "hotset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "format_version", "binding_sha256"],
      "properties": {
        "format": {"const": "exactscope.hotset"},
        "format_version": {"const": "0.1"},
        "binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "contract_id", "contract_version", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "enum": ["constrained-prompt.txt", "prompt-fragment.txt", "xs-calc.gbnf", "xs-calc.tool.json", "xs-eval.gbnf", "xs-eval.tool.json", "xs-request.gbnf"]
          },
          "kind": {"type": "string", "enum": ["tool-schema", "grammar", "prompt"]},
          "contract_id": {
            "type": "string",
            "enum": ["exactscope.constrained-prompt", "exactscope.prompt-fragment", "exactscope.xs-calc.gbnf", "exactscope.xs-calc.tool", "exactscope.xs-eval.gbnf", "exactscope.xs-eval.tool", "exactscope.xs-request.gbnf"]
          },
          "contract_version": {"const": "0.1"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
