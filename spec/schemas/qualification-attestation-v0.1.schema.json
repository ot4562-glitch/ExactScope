{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/qualification-attestation-v0.1.schema.json",
  "title": "ExactScope Qualification Attestation v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1},
    "format": {"const": "exactscope.qualification-attestation"},
    "format_version": {"const": "0.1"},
    "attestation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"enum": ["diagnostic", "failed", "inconclusive", "qualified"]},
    "candidate_policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workload_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "host_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["workload-owner", "local-qualified-process", "external-qualified-process"]},
        "authority_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "process_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": ["kind", "authority_id", "process_sha256"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluation_package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "analysis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "scorer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "economic_model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "required": [
        "evaluation_package_sha256",
        "analysis_sha256",
        "scorer_sha256",
        "economic_model_sha256"
      ]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {"enum": ["inspectable-pinned", "provider-observable"]},
        "issued_epoch_s": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "valid_until_epoch_s": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
        "observation_policy_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      },
      "required": ["scope", "issued_epoch_s", "valid_until_epoch_s", "observation_policy_id"]
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "passed": {"type": "boolean"},
          "observed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "unit": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "required": ["requirement_id", "passed", "observed", "unit"]
      },
      "minItems": 1
    },
    "mandatory_violations": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "required": [
    "v",
    "format",
    "format_version",
    "attestation_id",
    "status",
    "candidate_policy_sha256",
    "workload_contract_sha256",
    "host_manifest_sha256",
    "authority",
    "evidence",
    "validity",
    "gate_results",
    "mandatory_violations"
  ]
}
