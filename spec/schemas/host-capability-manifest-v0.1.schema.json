{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/host-capability-manifest-v0.1.schema.json",
  "title": "ExactScope Host Capability Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1},
    "format": {"const": "exactscope.host-capability-manifest"},
    "format_version": {"const": "0.1"},
    "host_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "qualification_scope": {"enum": ["inspectable-pinned", "provider-observable"]},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dependency_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {
            "enum": [
              "model",
              "runtime",
              "tokenizer-template",
              "retrieval",
              "index",
              "provider-interface",
              "tool-surface",
              "hardware",
              "other"
            ]
          },
          "identity": {"type": "string", "minLength": 1, "maxLength": 512},
          "assurance": {"enum": ["pinned", "host-asserted", "provider-guaranteed", "unknown"]},
          "valid_until_epoch_s": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
          "observation_policy_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
        },
        "required": [
          "dependency_id",
          "kind",
          "identity",
          "assurance",
          "valid_until_epoch_s",
          "observation_policy_id"
        ]
      },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "binding_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "assurance": {"enum": ["pinned", "host-asserted", "provider-guaranteed", "unknown"]}
        },
        "required": ["capability_id", "binding_id", "assurance"]
      },
      "minItems": 1
    },
    "supported_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 256},
          "rule_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "lowering_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "check_id": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "required": ["kind", "rule_id", "lowering_id", "check_id"]
      }
    },
    "exact_fit_supported": {"type": "boolean"},
    "max_model_calls": {"type": "integer", "minimum": 0, "maximum": 1024},
    "fallback_owner": {"const": "host"}
  },
  "required": [
    "v",
    "format",
    "format_version",
    "host_id",
    "qualification_scope",
    "dependencies",
    "capabilities",
    "exact_fit_supported",
    "max_model_calls",
    "fallback_owner"
  ]
}
