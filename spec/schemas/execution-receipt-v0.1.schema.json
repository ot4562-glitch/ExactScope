{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/execution-receipt-v0.1.schema.json",
  "title": "ExactScope Execution Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1},
    "format": {"const": "exactscope.execution-receipt"},
    "format_version": {"const": "0.1"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "phase": {"enum": ["admission", "finalization"]},
    "decision": {"enum": ["admitted", "rejected", "accepted"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workload_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "host_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "evidence_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rendered_request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_settings_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parent_admission_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "output_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  },
  "required": [
    "v",
    "format",
    "format_version",
    "receipt_id",
    "phase",
    "decision",
    "reason",
    "profile_sha256",
    "candidate_policy_sha256",
    "workload_contract_sha256",
    "host_manifest_sha256",
    "request_id",
    "evidence_snapshot_sha256",
    "rendered_request_sha256",
    "execution_settings_sha256",
    "parent_admission_receipt_sha256",
    "output_sha256"
  ]
}
