{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/grounding-source-snapshot-v0.1.schema.json",
  "title": "ExactScope grounding-source-snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "adapter_config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "encoding": {
            "enum": [
              "raw",
              "grounding-cjson-v0.1"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "encoding"
        ]
      },
      "minItems": 1
    },
    "item_identity_rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "v",
    "source_id",
    "source_revision",
    "adapter_id",
    "adapter_config_sha256",
    "revision_policy_id",
    "scope_policy_id",
    "files",
    "item_identity_rule_id"
  ]
}
