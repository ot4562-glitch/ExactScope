{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/fact-pack-source.schema.json",
  "title": "ExactScope factual recall pack source v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "pack_id",
    "pack_revision",
    "authority",
    "facts"
  ],
  "properties": {
    "format": {"const": "exactscope.fact-pack.source"},
    "format_version": {"const": "0.1"},
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "pack_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "authority": {
      "type": "string",
      "enum": ["authoritative", "supplemental"]
    },
    "languages": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 32
      }
    },
    "source_set_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65535,
      "items": {"$ref": "#/$defs/fact"}
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence", "source", "revision", "aliases"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192
          }
        },
        "source_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "valid_from": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
