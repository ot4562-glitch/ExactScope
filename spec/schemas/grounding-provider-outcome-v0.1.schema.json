{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exactscope.org/spec/schemas/grounding-provider-outcome-v0.1.schema.json",
  "title": "ExactScope grounding-provider-outcome v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "qid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "security_scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_snapshot_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "ok",
        "none",
        "timeout",
        "error",
        "denied",
        "budget_exceeded"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "grounding-evidence-item-v0.1.schema.json"
      },
      "minItems": 0
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "v",
    "qid",
    "profile_sha256",
    "security_scope_id",
    "target_key",
    "provider_id",
    "attempt",
    "source_snapshot_refs",
    "status",
    "complete",
    "candidates",
    "reason"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": true
          },
          "candidates": {
            "maxItems": 0
          },
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "candidates": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "timeout",
              "error",
              "denied",
              "budget_exceeded"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  ]
}
